<!DOCTYPE html>
<html lang="zh-Hant">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="小農分享平台，認識在地優質小農與他們的農產故事。" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " - " : "")小農分享平台</title>

    @await Html.PartialAsync("_Styles")
    <link rel="stylesheet" href="~/lib/owlcarousel/owl.carousel.min.css" />
    <link rel="stylesheet" href="~/css/style.css" />
    <link rel="stylesheet" href="~/css/responsive.css" />
    <link rel="stylesheet" href="~/css/banner.css" />
    <link rel="stylesheet" href="~/css/login.css" />
</head>

<body class="@ViewData["BodyClass"]">
    <div class="hero_area">
        <div class="brand_box"></div>
        <div>
            @RenderSection("Slider", required: false)
        </div>
    </div>

    <!-- nav section -->
    <section class="nav_section">
        <div class="container">
            <div class="custom_nav2">
                <nav class="navbar navbar-expand custom_nav-container">
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="navbarSupportedContent">
                        <div class="d-flex flex-column flex-lg-row align-items-center">
                            <ul class="navbar-nav">
                                <li class="nav-item active">
                                    <a class="nav-link" href="/Home/index">首頁 <span class="visually-hidden">(current)</span></a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="/Home/about">關於我們</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="/Home/crop">優質小農</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="/Home/testimonial">小農推薦</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="/Article/Blog">部落格</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="/Home/contact">聯絡我們</a>
                                </li>
                            </ul>
                            <ul class="navbar-nav ms-auto">
                                @if (Context.Session.GetString("IsLoggedIn") == "true")
                                {
                                    <select class="dropdown-btn" onchange="window.location.href=this.value;">
                                        <option value="#" disabled selected>會員專區</option>
                                        <option value="@Url.Action("reviseAccount", "Login")">會員修改</option>
                                        <option value="@Url.Action("Logout1", "Home")">登出</option>
                                    </select>
                                }
                                else
                                {
                                    <li class="nav-item">
                                        <a class="nav-link" href="@Url.Action("login", "Home")">登入</a>
                                    </li>
                                }
                            </ul>
                            <form class="form-inline d-flex my-2 my-lg-0 ms-0 ms-lg-4 mb-3 mb-lg-0" action="/Farmer/FarmersIndex" method="get">
                                <input class="form-control nav_search-input" type="text" placeholder="Search" name="keyword" aria-label="Search" />
                                <button class="btn nav_search-btn" type="submit"></button>
                            </form>
                        </div>
                    </div>
                </nav>
            </div>
        </div>
    </section>

    <!-- body -->
    <div>
        @RenderBody()
    </div>

    <!-- info section -->
    <section class="info_section layout_padding">
        <div class="container">
            <div class="info_logo">
                <h2>小農資訊平台</h2>
            </div>
            <div class="info_contact">
                <div class="row">
                    <div class="col-md-4">
                        <div>
                            <img src="~/images/location.png" alt="地址" />
                            <span>100台北市中正區羅斯福路三段272號3樓</span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div>
                            <img src="~/images/call.png" alt="電話" />
                            <span>(02)2364-8885</span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div>
                            <img src="~/images/mail.png" alt="信箱" />
                            <span>Iccent@@gmail.com</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    @await Html.PartialAsync("_Scripts")
    <script src="~/js/custom.js"></script>
    @RenderSection("Scripts", required: false)
</body>

</html>
