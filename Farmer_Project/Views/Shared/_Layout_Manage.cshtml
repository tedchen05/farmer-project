<!DOCTYPE html>
<html lang="zh-Hant">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="小農分享平台後台管理系統。" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " - " : "")小農分享平台後台</title>

    @await Html.PartialAsync("_Styles")
    <link rel="stylesheet" href="~/css/style.css" />
    <link rel="stylesheet" href="~/css/responsive.css" />
    <link rel="stylesheet" href="~/css/sidebars.css" />
    <link rel="stylesheet" href="~/css/manage.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <header class="py-3 mb-3 border-bottom">
        <h1 class="text-center">後台管理系統</h1>
    </header>

    <div class="container-fluid">
        <div class="row">
            @await Html.PartialAsync("_Sidebar")

            <div class="col p-3 shadow">
                <main>
                    @RenderBody()
                </main>
            </div>
        </div>
    </div>

    @await Html.PartialAsync("_Scripts")
    <script src="~/js/manage.js"></script>
    @await Html.PartialAsync("_Flash")
    @RenderSection("Scripts", required: false)
</body>

</html>
