@* 後台共用側邊欄 *@
<div class="col-md-3 flex-shrink-0 p-3 bg-white shadow" style="width: 280px; margin-right: 20px;">
    <div class="d-flex align-items-center pb-3 mb-3 border-bottom">
        <span class="fs-5 fw-semibold" style="font-weight: bold;">小農分享平台</span>
    </div>
    <ul class="list-unstyled ps-0">
        <li class="mb-1">
            <a class="btn rounded w-100 text-start" href="@Url.Action("DashBoard", "Farmer", new { show = "memberTable" })">會員管理</a>
        </li>
        <li class="mb-1">
            <a class="btn rounded w-100 text-start" href="@Url.Action("DashBoard", "Farmer", new { show = "messageForm" })">訊息發送</a>
        </li>
        <li class="mb-1">
            <a class="btn rounded w-100 text-start" href="@Url.Action("DashBoard", "Farmer", new { show = "FarmersInfoTable" })">小農資料</a>
        </li>
        <li class="mb-1">
            <a class="btn rounded w-100 text-start" href="@Url.Action("DashBoard", "Farmer", new { show = "FarmersArticlesList" })">小農文章</a>
        </li>
        <li class="border-top my-3"></li>
        <li class="mb-1">
            <button class="btn rounded w-100 text-start" id="logoutBtn">登出</button>
            <form action="@Url.Action("Logout", "Account")" method="post" id="logoutForm" style="display:none;"></form>
        </li>
    </ul>
</div>
