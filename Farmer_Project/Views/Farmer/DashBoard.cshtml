@model Farmer_Project.Entities.FarmersAndMembersViewModel
@{
    Layout = "~/Views/Shared/_Layout_Manage.cshtml";
    ViewData["Title"] = "後台管理系統";
}

    <header class="py-3 mb-3 border-bottom">
        <center><h1 class="text-center">後台管理系統</h1></center>
    </header>
    <div class="container-fluid">
        <div class="row">
            <!-- 左側欄(功能列) -->
            <div class="col-md-3 flex-shrink-0 p-3 text-white bg-white shadow" style="width: 280px; margin-right: 20px;">
                <div class="d-flex align-items-center pb-3 mb-3 link-dark text-decoration-none border-bottom">
                    <svg class="bi me-2" width="30" height="24"><use xlink:href="#bootstrap"></use></svg>
                    <span class="fs-5 fw-semibold" style="color: black; font-size: 20px; font-weight: bold;">
                        小農分享平台
                    </span>
                </div>
                <ul class="list-unstyled ps-0">
                    <li class="mb-1">
                        <button class="btn align-items-center rounded" id="showActions">
                            會員管理
                        </button>
                    </li>
                    <li class="mb-1">
                        <button class="btn align-items-center rounded" id="messageBtn">
                            訊息發送
                        </button>
                    </li>
                        <li class="mb-1">
                        <button class="btn align-items-center rounded" id="FarmersInfo">
                            小農資料
                        </button>
                    <li class="mb-1">
                        <button class="btn align-items-center rounded" id="FarmersArticle">
                            小農文章
                        </button>
                    </li>
                    <li class="border-top my-3"></li>
                    <li class="mb-1">
                        <button class="btn btn-toggle align-items-center rounded collapsed" data-bs-toggle="collapse" data-bs-target="#account-collapse" aria-expanded="false" id="logoutBtn">
                            登出
                        </button>
                        <form action="@Url.Action("Logout", "Home")" method="post" id="logoutForm" style="display:none;">
                                @* POST 方法發送登出請求 *@
                        </form>
                        <div class="collapse" id="account-collapse">
                            <ul class="btn-toggle-nav list-unstyled fw-normal pb-1 small">
                                
                            </ul>
                        </div>
                    </li>
                </ul>
            </div>

            <!-- 右側欄(內容區域) -->
            <!-- 其他內容 -->
            <div class="col p-3 shadow">
            @* <div id="messageForm" style="@((TempData["messageBtn"] != null && (bool)TempData["messageBtn"]) ? "display:block;" : "display:none;")">  舊的程式碼*@
                <div id="messageForm" style="@((TempData["messageBtn"] as bool? ?? false) ? "display:block;" : "display:none;")">

                    <h3>發送訊息</h3>
                    @if (TempData["LabelResult"] != null)
                    {
                        <div class="alert alert-info">
                            @TempData["LabelResult"]
                        </div>
                    }

                    <!-- 發送郵件的表單 -->
                    <form method="post" action="@Url.Action("SendEmail", "Message")">
                        <div class="mb-3">
                            <label for="Message" class="form-label">訊息內容</label>
                            <textarea class="form-control" id="Message" name="message" rows="3" required></textarea>
                        </div>
                        <input type="hidden" name="actionType" value="yes" />
                        <button type="submit" class="btn btn-primary">發送郵件</button>
                    </form>
                </div>
            @* <div id="memberTable" style="display:@(TempData["dele"] != null && (bool)TempData["dele"] ? "block" : "none");"> 舊的程式碼*@
                <div id="memberTable" style="display:@((TempData["dele"] as bool?) ?? false ? "block" : "none");">
                    <h3>會員列表 </h3>
                    <form method="get" action="@Url.Action("Index", "Member")">
                        <div class="input-group mb-3">
                            <input type="text" class="form-control" placeholder="搜尋會員" name="searchTerm" value="@ViewBag.SearchTerm" />
                            <button class="btn btn-outline-secondary" type="submit">搜尋</button>
                        </div>
                    </form>

                    <a href="@Url.Action("Create", "Member")" class="btn btn-sm btn-primary mb-3">新增</a>
                    <form method="post" action="@Url.Action("ReloadData", "Member")" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-secondary mb-3">取消搜尋</button>
                    </form>
                    <form method="post" action="@Url.Action("ReloadData", "Member")">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>編號</th>
                                    <th>權限</th>
                                    <th>名稱</th>
                                    <th>帳號</th>
                                    <th>操作</th>
                                </tr>
                            </thead>
                            <tbody>
                            @if (Model.MemberInformations.Any())
                            {
                                foreach (var member in Model.MemberInformations)
                                {
                                    <tr>
                                        <td>@member.Id</td>
                                        <td>@member.Sort</td>
                                        <td>@member.NickName</td>
                                        <td>@member.Account</td>
                                        <td>
                                            <!-- 編輯操作 -->
                                            <button type="submit" name="action" value="edit" class="btn btn-sm btn-warning" formaction="@Url.Action("Edit", "Member", new { id = member.Id })">編輯</button>

                                            <!-- 刪除操作 -->
                                            <button type="button" class="btn btn-sm btn-danger delete-btn" data-id="@member.Id">刪除</button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center">沒有資料可顯示。</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </form>
                </div>

  

                <!-- 小農資料區 -->
                <div id="FarmersInfoTable" class="container-fluid" style="display:none;">
                    <div class="d-flex justify-content-end p-3">
                        <div class="d-flex align-items-center">
                            <form class="w-70 me-3 input-group" action="/Farmer/FarmersInfoSearch" method="get">
                                <input type="search" name="Search" class="form-control rounded-pill me-1" placeholder="Search..." aria-label="Search">
                                <button class="btn border rounded-pill" type="submit"><i class="fa-solid fa-magnifying-glass"></i></button>
                            </form>
                        </div>
                    </div>

                    <div class="d-flex mb-2">
                        <div class="me-3 p-1">
                            <h2>小農資料</h2>
                        </div>
                        <div>
                            <a href="/Farmer/FarmersInfoAdd" id="farmersCreate" class="btn btn-primary">新增成員</a>
                        </div>
                    </div>
                    <hr />
                    <table class="table">
                        <thead>
                            <tr>
                                <th scope="col-1">小農編號</th>
                                <th scope="col">小農負責人</th>
                                <th scope="col">農場名稱</th>
                                <th scope="col">農作物</th>
                                <th scope="col">農場地址</th>
                                <th scope="col">聯絡電話</th>
                                <th scope="col">信箱</th>
                                <th scope="col">操作</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.FarmersInfos.Any())
                            {
                                foreach (var item in Model.FarmersInfos.Select((farmer, idx) => new { farmer = farmer, idx = idx + 1 }))
                                {
                                    <tr>
                                        <th scope="row">@item.idx</th>
                                        <td>@item.farmer.Name</td>
                                        <td>@item.farmer.FarmName</td>
                                        <td>@item.farmer.CropsType</td>
                                        <td>@item.farmer.Address</td>
                                        <td>@item.farmer.Phone</td>
                                        <td>@item.farmer.Email</td>
                                        <td class="d-flex">
                                            <a href="/Farmer/FarmersInfoEdit/@item.farmer.FarmersId" class="btn btn-success me-2">編輯</a>
                                            <form method="post" action="/Farmer/FarmersInfoDelete" onsubmit="return confirm('確認刪除這筆資料？ 此資料刪除會包含所屬文章一併刪除');">
                                                <input type="hidden" name="DeleteFarmersId" value="@item.farmer.FarmersId" />
                                                <button type="submit" class="btn btn-danger">刪除</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <h2 class="bg-primary">目前沒有資料</h2>
                            }
                        </tbody>
                    </table>
                </div>
                <!-- 小農文章區 -->
                <div id="FarmersArticlesList" class="container-fluid" style="display:none;">
                    <h2>小農文章</h2>
                    <hr />
                    @foreach (var item in Model.FarmersInfos.Select((farmer, idx) => new { farmer = farmer, idx = idx }))
                    {
                        <div class="accordion" id="accordionExample_@(item.idx +1)">
                            <div class="accordion-item">
                                <h2 class="accordion-header" id="heading_@(item.idx +1)">
                                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapse_@(item.idx + 1)" aria-expanded="false" aria-controls="collapse_@(item.idx +1)">
                                        <div class="me-3">@(item.idx + 1)</div>
                                        <div>@item.farmer.FarmName</div>
                                    </button>
                                </h2>
                                <div id="collapse_@(item.idx +1)" class="accordion-collapse collapse " aria-labelledby="heading_@(item.idx +1)" data-bs-parent="#accordionExample">
                                    <div class="accordion-body">
                                        <div>
                                            <a href="/Article/FarmersArtAdd/@item.farmer.FarmersId" id="FarmersArtAdd" class="btn btn-primary">新增文章</a>
                                        </div>

                                        @{
                                            bool hasArticles = item.farmer.FarmersArticles.Any();
                                        }

                                        @if (hasArticles)
                                        {
                                            <table class="table">
                                                <thead>
                                                    <tr>
                                                        <th scope="col-1">編號</th>
                                                        <th scope="col">標題</th>
                                                        <th scope="col">文章分類</th>
                                                        <th scope="col">文章圖片</th>
                                                        <th scope="col">發佈</th>
                                                        <th scope="col">編輯日期</th>
                                                        <th scope="col">操作</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var (article, idx) in item.farmer.FarmersArticles.Select((article, index) => (article, index)))
                                                    {
                                                        <tr>
                                                            <th scope="row" style=" vertical-align: middle;">@(idx + 1)</th>
                                                            <td style=" vertical-align: middle;">@article.ArticleTitle</td>
                                                            <td style=" vertical-align: middle;">@article.ArticleType</td>
                                                            <td style=" vertical-align: middle;"><img src="@article.ArticleImagePath" style="max-width: 100px; max-height: 100px; object-fit: cover;"></img></td>
                                                            <td style=" vertical-align: middle;">@(article.IsPublished ? "是" : "否")</td>
                                                            <td style=" vertical-align: middle;">@article.CreatedDate</td>

                                                            <td class="d-flex" style="vertical-align: middle; align-items: center; height:130px">
                                                                <a href="/Article/FarmersArtEdit/@article.ArticlesId" class="btn btn-success me-2">編輯</a>
                                                                <form method="post" action="/Article/FarmersArtDelete" onsubmit="return confirm('確認刪除這筆資料？');">
                                                                    <input type="hidden" name="DeleteArticlesId" value="@article.ArticlesId" />
                                                                    <button type="submit" class="btn btn-danger">刪除</button>
                                                                </form>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        }
                                        else
                                        {
                                            <h3 class="my-3 p-3 bg-warning rounded"> 目前沒有文章 </h3>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
             
            </div>
            
        </div>

@section Scripts {
    <script src="~/js/manage.js"></script>
}
