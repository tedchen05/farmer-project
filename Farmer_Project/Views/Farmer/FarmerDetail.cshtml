@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using Farmer_Project.Entities
@model FarmersArticles


@{
    var subArticle = Model.FarmersArticlesDetails;
}
<img src="@subArticle[1].SubImagePath" class="img-fluid" />
<hr />

<div>
    <div class="tab-content">
        <div id="tab-1" class="row d-flex tab-pane fade show active">
            <div class="col-lg-6">
                <div class="row g-4 align-items-center">
                    <div class="col-6 mb-2">
                        <img src="@Model.FarmersArticlesDetails[0].SubImagePath" class="img-fluid w-100 farmer_photo" alt="">
                    </div>
                    <div class="col-6 mb-2">
                        <h3>@Model.FarmersInfo.Name</h3>
                        <p class="mb-2 f-3">
                            <i class="fa-solid fa-house"></i> @Model.FarmersInfo.FarmName
                        </p>
                        <p class="mb-2 f-3">
                            <i class="fa-solid fa-envelope"></i> @Model.FarmersInfo.Email
                        </p>
                        <p class="mb-2 f-3">
                            <i class="fa-solid fa-phone"></i> @Model.FarmersInfo.Phone
                        </p>
                        <p class="mb-2 f-3">
                            <i class="fa-solid fa-location-dot"></i> @Model.FarmersInfo.Address
                        </p>
                    </div>
                </div>
            </div>

            <!-- Google Maps -->
            <div class="col-lg-6 ">
                <div class="map-container pe-3 pb-3">
                    <iframe src="https://www.google.com/maps?q=@Model.FarmersInfo.Address&output=embed"
                            frameborder="0"
                            style="border:0">
                    </iframe>
                </div>
            </div>
        </div>
    </div>


</div>





@section Styles {
    <link rel="stylesheet" href="~/css/farmerDetail.css" />
}
