@model Farmer_Project.Models.Login.ForgetPasswordInput
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container">
    <form method="post" action="/Account/ResetPasswd">
        @Html.AntiForgeryToken()
        <br />
        <h2>密碼重設</h2>
        <br />

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <label asp-for="Account">會員帳號</label>
        <br />
        <input asp-for="Account" class="form-control" placeholder="輸入您的電子信箱" />
        <span asp-validation-for="Account" class="text-danger"></span>
        <br /><br />

        <input type="submit" name="submit" value="確認帳號" class="btn btn-primary" />
        <br /><br />
    </form>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script type="text/javascript">
        var message = @Html.Raw(Json.Serialize(TempData["message"]));
        if (message) { alert(message); }
    </script>
}
