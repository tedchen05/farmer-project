@{
    Layout = "/Views/Shared/_Layout.cshtml";
}

<!-- nav section -->
<!-- login section -->
<div class="container">
    <form method="post" action="/Account/Login" class="mt-4">
        <font size="6">會員登入</font>
        <br />
        <br />
        <label>會員帳號</label>
        <br />
        <input type="text" name="account" class="form-control" placeholder="您的電子信箱" required data-val="true" data-val-number="欄位 ID 必須是數字。" />
        <div>
            <span style="color:red">@ViewBag.Msg1</span>
        </div>
        <div>
            <span style="color:red">@ViewBag.Msg2</span>
        </div>
        <div>
            <span style="color:red">@ViewBag.Msg3</span>
        </div>
        <br />
        <br />
        <label>會員密碼</label>
        <br />
        <input type="password" name="passwd" class="form-control" placeholder="8~12位數的密碼組合" required />
        <div>
            <span style="color:red">@ViewBag.Msg1</span>
        </div>
        <div>
            <span style="color:red">@ViewBag.Msg4</span>
        </div>
        <br />
        <br />
        <input type="submit" name="submit" value="登入" class="btn btn-primary" />
        <br />
        <br />
        <a href="/Account/resetPasswd">忘記密碼?</a>
        @* <p>@Html.ActionLink("忘記密碼?", "resetPasswd")</p> *@
        <br />
        <br />
        <h2>還不是會員?</h2>
        <br />
        <a href="/Account/register">註冊會員</a>
        <br />
        <br />
        @* <p>@Html.ActionLink("註冊會員", "register")</p> *@
    </form>
</div>
<!-- end login section -->
@*<div style="text-align:center;vertical-align:middle;"> 此為將文本置中

    </div>*@


@*以下為回傳訊息的必須指令*@
@if (TempData["message"] != null)
{
}

@section Scripts {
<script type="text/javascript">
        var message = @Html.Raw(Json.Serialize(TempData["message"]));
        @* 專案類型"ASP.NET CORE WEB 應用程式(MVC)" 的用Json.Serialize; "ASP.NET WEB 應用程式(.NET Framework)" 的用Json.Encode *@
            if (message) { alert(message); }
    </script>
}
