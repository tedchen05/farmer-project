@model Farmer_Project.Models.Login.LoginInput
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "/Views/Shared/_Layout.cshtml";
}

<!-- login section -->
<div class="container">
    <form method="post" action="/Account/Login" class="mt-4">
        @Html.AntiForgeryToken()
        <font size="6">會員登入</font>
        <br /><br />

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <label asp-for="Account">會員帳號</label>
        <br />
        <input asp-for="Account" class="form-control" placeholder="您的電子信箱" />
        <span asp-validation-for="Account" class="text-danger"></span>
        <br /><br />

        <label asp-for="Passwd">會員密碼</label>
        <br />
        <input asp-for="Passwd" type="password" class="form-control" placeholder="8~12位數的密碼組合" />
        <span asp-validation-for="Passwd" class="text-danger"></span>
        <br /><br />

        <input type="submit" name="submit" value="登入" class="btn btn-primary" />
        <br /><br />
        <a href="/Account/ResetPasswd">忘記密碼?</a>
        <br /><br />
        <h2>還不是會員?</h2>
        <br />
        <a href="/Account/Register">註冊會員</a>
        <br /><br />
    </form>
</div>
<!-- end login section -->

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
