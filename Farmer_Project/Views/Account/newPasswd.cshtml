@model Farmer_Project.Models.Login.NewPasswordInput
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container">
    <form method="post" action="/Account/NewPasswd">
        @Html.AntiForgeryToken()
        <br />
        <h2>密碼重設</h2>
        <br />

        <div asp-validation-summary="All" class="text-danger"></div>

        <label asp-for="Passwd">新密碼</label>
        <br />
        <input asp-for="Passwd" type="password" class="form-control" placeholder="輸入8~12位數的密碼組合" />
        <span asp-validation-for="Passwd" class="text-danger"></span>
        <br /><br />

        <label asp-for="Passwd2">再次輸入新密碼</label>
        <br />
        <input asp-for="Passwd2" type="password" class="form-control" placeholder="輸入8~12位數的密碼組合" />
        <span asp-validation-for="Passwd2" class="text-danger"></span>
        <br /><br />

        <input type="submit" name="submit" value="重設密碼" class="btn btn-primary" />
        <br /><br />
    </form>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script type="text/javascript">
        var message = @Html.Raw(Json.Serialize(TempData["message"]));
        if (message) { alert(message); }
    </script>
}
