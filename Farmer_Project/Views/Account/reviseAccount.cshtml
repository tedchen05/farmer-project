@model Farmer_Project.Models.Login.ReviseAccountInput
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container">
    <form method="post" action="/Account/ReviseAccount">
        @Html.AntiForgeryToken()
        <br />
        <h2>會員修改</h2>
        <br />

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <label asp-for="NickName">*會員暱稱</label>
        <br />
        <input asp-for="NickName" class="form-control" placeholder="建議不要使用真實姓名" />
        <span asp-validation-for="NickName" class="text-danger"></span>
        <br /><br />

        <label asp-for="Account">*會員帳號</label>
        <br />
        <input asp-for="Account" class="form-control" readonly />
        <br /><br />

        <label asp-for="Passwd">*會員密碼</label>
        <br />
        <input asp-for="Passwd" type="password" class="form-control" placeholder="輸入8~12位數的密碼組合" />
        <span asp-validation-for="Passwd" class="text-danger"></span>
        <br /><br />

        <input type="submit" name="submit" value="修改" class="btn btn-primary" />
        <br /><br />
    </form>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
